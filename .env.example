# Supabase → Project Settings → API
# Use the *anon / publishable* key only. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: public origin used in the QR code (defaults to window.location.origin).
# Handy when hosting from localhost but players join over your LAN / a tunnel.
# VITE_PUBLIC_URL=https://bug-or-bluff.vercel.app
